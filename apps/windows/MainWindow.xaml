<Window
    x:Class="ReviewRadar.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReviewRadar.Windows"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging"
    xmlns:models="using:ReviewRadar.Windows.Models"
    Title="Review Radar">
    <Grid x:Name="Root" Loaded="Root_Loaded" Background="#F6F7FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="20" Background="#F0F2F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Width="34" Height="34" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <media:SvgImageSource UriSource="ms-appx:///Assets/logo.svg" />
                    </Image.Source>
                </Image>
                <TextBlock VerticalAlignment="Center" Text="Review Radar" FontSize="18" FontWeight="SemiBold" Foreground="#20283F" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,32,0,0" Spacing="4">
                <TextBlock Text="WORKSPACES" FontSize="11" FontWeight="SemiBold" Foreground="#596279" />
                <ListView SelectedIndex="0" SelectionMode="Single" IsItemClickEnabled="False">
                    <ListViewItem Content="Tailored to you" IsSelected="True" />
                    <ListViewItem Content="Action (planned)" IsEnabled="False" />
                    <ListViewItem Content="My PRs (planned)" IsEnabled="False" />
                    <ListViewItem Content="Following (planned)" IsEnabled="False" />
                    <ListViewItem Content="Recent (planned)" IsEnabled="False" />
                </ListView>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="LOCAL TO THIS DEVICE" FontSize="11" FontWeight="SemiBold" Foreground="#596279" />
                <TextBlock Text="Read and snoozed pull requests stay quiet until something meaningful changes." TextWrapping="Wrap" Foreground="#596279" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WORKSPACE / TAILORED TO YOU" FontSize="11" FontWeight="SemiBold" Foreground="#596279" />
                    <TextBlock Text="Tailored to you" FontSize="30" FontWeight="SemiBold" Foreground="#20283F" />
                    <TextBlock Text="Your next move, in focus." Foreground="#596279" />
                </StackPanel>
                <Button Grid.Column="1" Click="Refresh_Click" VerticalAlignment="Center" AutomationProperties.Name="Refresh pull requests">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <ListView Grid.Row="1" Margin="0,24,0,16" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PullRequestCard">
                        <Border Margin="0,0,0,8" Padding="16" Background="White" BorderBrush="#E4E7EF" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{x:Bind RepositoryAndNumber}" FontSize="12" Foreground="#596279" />
                                <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" Foreground="#20283F" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Explanation.Heading}" FontWeight="SemiBold" Foreground="#635BDF" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind PrimaryReasonSummary}" Foreground="#596279" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ActionLabel}" FontWeight="SemiBold" Foreground="#635BDF" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="#596279" TextWrapping="Wrap" />
        </Grid>

        <ScrollViewer Grid.Column="2" Padding="24" Background="White" BorderBrush="#E4E7EF" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="PULL REQUEST" FontSize="11" FontWeight="SemiBold" Foreground="#596279" />
                <TextBlock Text="{Binding SelectedCard.RepositoryAndNumber}" Foreground="#596279" />
                <TextBlock Text="{Binding SelectedCard.Title}" FontSize="22" FontWeight="SemiBold" Foreground="#20283F" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedCard.Explanation.Heading}" FontWeight="SemiBold" Foreground="#635BDF" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedCard.PrimaryReasonSummary}" Foreground="#596279" TextWrapping="Wrap" />
                <TextBlock Text="Select a pull request to inspect its projected explanation and next action." Foreground="#788197" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
