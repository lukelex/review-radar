#!/usr/bin/env bash
set -euo pipefail

repository=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository"

version=${1:?usage: scripts/package-macos VERSION}
case "$version" in
    v*) tag=$version; version=${version#v} ;;
    *) tag="v$version" ;;
esac
case "$version" in
    *[!0-9A-Za-z.-]*|'')
        printf '%s\n' "Version must contain only letters, numbers, dots, and hyphens: $version" >&2
        exit 1
        ;;
esac

command -v cargo >/dev/null
command -v swift >/dev/null
command -v lipo >/dev/null
command -v codesign >/dev/null
command -v ditto >/dev/null
command -v iconutil >/dev/null
command -v qlmanage >/dev/null
command -v sips >/dev/null

name="review-radar-macos-universal-$version"
release_root="$repository/build/release"
bundle="$release_root/$name/Review Radar.app"
archive="$repository/build/$name.zip"
work="$repository/build/macos-package-work"
identity=${MACOS_CODESIGN_IDENTITY:-}
notary_profile=${MACOS_NOTARY_PROFILE:-}

rm -rf "$release_root/$name" "$work" "$archive" "$archive.sha256"
mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Helpers" "$bundle/Contents/Resources" "$work"

for rust_target in aarch64-apple-darwin x86_64-apple-darwin; do
    rustup target add "$rust_target"
    cargo build --release --locked --target "$rust_target" -p review-radar-github \
        --bin review-radar-github --bin review-radar-queue
    cargo build --release --locked --target "$rust_target" -p review-radar-state \
        --bin review-radar-state
done

for architecture in arm64 x86_64; do
    scratch="$work/swift-$architecture"
    (
        cd apps/macos
        swift build --configuration release --arch "$architecture" --scratch-path "$scratch" \
            --product ReviewRadarMac
        bin_path=$(swift build --show-bin-path --configuration release --arch "$architecture" \
            --scratch-path "$scratch")
        cp "$bin_path/ReviewRadarMac" "$work/ReviewRadarMac-$architecture"
    )
done

lipo -create "$work/ReviewRadarMac-arm64" "$work/ReviewRadarMac-x86_64" \
    -output "$bundle/Contents/MacOS/ReviewRadarMac"
for helper in review-radar-github review-radar-queue review-radar-state; do
    lipo -create \
        "$repository/target/aarch64-apple-darwin/release/$helper" \
        "$repository/target/x86_64-apple-darwin/release/$helper" \
        -output "$bundle/Contents/Helpers/$helper"
done

iconset="$work/AppIcon.iconset"
mkdir -p "$iconset"
qlmanage -t -s 1024 -o "$work" "$repository/docs/assets/logo.svg" >/dev/null
rendered_icon="$work/logo.svg.png"
test -f "$rendered_icon"
for size in 16 32 128 256 512; do
    sips -z "$size" "$size" "$rendered_icon" --out "$iconset/icon_${size}x${size}.png" >/dev/null
    doubled=$((size * 2))
    sips -z "$doubled" "$doubled" "$rendered_icon" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$bundle/Contents/Resources/AppIcon.icns"

cat > "$bundle/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleDisplayName</key><string>Review Radar</string>
    <key>CFBundleExecutable</key><string>ReviewRadarMac</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIdentifier</key><string>org.reviewradar.app</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Review Radar</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
EOF
printf 'APPL????' > "$bundle/Contents/PkgInfo"

if [ -n "$identity" ]; then
    signing=(--force --options runtime --timestamp --sign "$identity")
else
    signing=(--force --sign -)
fi

for helper in "$bundle"/Contents/Helpers/*; do
    codesign "${signing[@]}" "$helper"
done
codesign "${signing[@]}" "$bundle"
codesign --verify --deep --strict --verbose=2 "$bundle"
plutil -lint "$bundle/Contents/Info.plist"

for executable in "$bundle/Contents/MacOS/ReviewRadarMac" "$bundle"/Contents/Helpers/*; do
    architectures=$(lipo -archs "$executable")
    case "$architectures" in
        *arm64*x86_64*|*x86_64*arm64*) ;;
        *) printf '%s\n' "Expected universal binary: $executable ($architectures)" >&2; exit 1 ;;
    esac
done

ditto -c -k --keepParent "$bundle" "$archive"
if [ -n "$notary_profile" ]; then
    if [ -z "$identity" ]; then
        printf '%s\n' "MACOS_NOTARY_PROFILE requires MACOS_CODESIGN_IDENTITY." >&2
        exit 1
    fi
    xcrun notarytool submit "$archive" --keychain-profile "$notary_profile" --wait
    xcrun stapler staple "$bundle"
    ditto -c -k --keepParent "$bundle" "$archive"
fi

shasum -a 256 "$archive" > "$archive.sha256"
unzip -l "$archive" | grep -F 'Review Radar.app/Contents/Helpers/review-radar-queue' >/dev/null
printf '%s\n' "$tag $archive $archive.sha256"
