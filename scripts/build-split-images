#!/bin/sh
set -eu

core_image=${CORE_IMAGE:-review-radar-core:local}
desktop_image=${DESKTOP_IMAGE:-review-radar-desktop:local}

docker build -f Dockerfile.core -t "$core_image" .
docker build -f Dockerfile.desktop --build-arg CORE_IMAGE="$core_image" -t "$desktop_image" .

printf '%s\n' "Built $core_image and $desktop_image"
